{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reasonflow.com/schemas/workflow.json",
  "title": "ReasonFlow Workflow",
  "description": "Schema for ReasonFlow workflow definitions",
  "type": "object",
  "required": ["name", "version", "steps"],
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the workflow",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "The version of the workflow (semver format)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "A description of what the workflow does"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the workflow",
      "properties": {
        "author": {
          "type": "string",
          "description": "The author of the workflow"
        },
        "tags": {
          "type": "array",
          "description": "Tags to categorize the workflow",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "description": "Input parameters for the workflow",
      "items": {
        "$ref": "#/definitions/parameter"
      }
    },
    "outputs": {
      "type": "array",
      "description": "Output values from the workflow",
      "items": {
        "$ref": "#/definitions/parameter"
      }
    },
    "steps": {
      "type": "array",
      "description": "The steps that make up the workflow",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "definitions": {
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the parameter",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "The data type of the parameter",
          "enum": ["string", "number", "boolean", "object", "array"]
        },
        "description": {
          "type": "string",
          "description": "A description of the parameter"
        },
        "required": {
          "type": "boolean",
          "description": "Whether the parameter is required",
          "default": false
        },
        "default": {
          "description": "The default value for the parameter"
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the step",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for the step"
        },
        "type": {
          "type": "string",
          "description": "The type of step",
          "enum": ["action", "decision", "parallel", "loop", "subworkflow"]
        },
        "description": {
          "type": "string",
          "description": "A description of what the step does"
        },
        "action": {
          "type": "string",
          "description": "The action to execute (for action type steps)"
        },
        "condition": {
          "type": "string",
          "description": "The condition to evaluate (for decision type steps)"
        },
        "inputs": {
          "type": "object",
          "description": "Input values for the step",
          "additionalProperties": true
        },
        "outputs": {
          "type": "object",
          "description": "Output mappings from the step",
          "additionalProperties": {
            "type": "string"
          }
        },
        "next": {
          "type": "string",
          "description": "The ID of the next step to execute"
        },
        "onSuccess": {
          "type": "string",
          "description": "The ID of the step to execute on success"
        },
        "onFailure": {
          "type": "string",
          "description": "The ID of the step to execute on failure"
        },
        "branches": {
          "type": "array",
          "description": "Branches for decision or parallel steps",
          "items": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string",
                "description": "Condition for this branch"
              },
              "steps": {
                "type": "array",
                "description": "Steps to execute in this branch",
                "items": {
                  "$ref": "#/definitions/step"
                }
              }
            }
          }
        },
        "retry": {
          "type": "object",
          "description": "Retry configuration for the step",
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "description": "Maximum number of retry attempts",
              "minimum": 1
            },
            "backoff": {
              "type": "string",
              "description": "Backoff strategy",
              "enum": ["fixed", "exponential", "linear"]
            },
            "delay": {
              "type": "integer",
              "description": "Delay between retries in milliseconds",
              "minimum": 0
            }
          }
        },
        "timeout": {
          "type": "integer",
          "description": "Timeout for the step in milliseconds",
          "minimum": 0
        }
      }
    }
  }
}
